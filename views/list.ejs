<%- include('includes/_header.ejs') %>

<label for="buscar">Buscar</label>
<input
  class="input is-primary"
  type="text"
  id="buscar"
  placeholder="Minecr..."
/>
<br><br>

<% for (let privilegio of privilegios) { %>
  <% if (privilegio.privilegio == 'crear_videojuegos') { %>
    <a href="/videojuegos/new"><button class="button is-primary">Nuevo videojuego</button></a>
  <% } %>
<% } %>

              <div class="columns" id="lista">

        <% for (let juego of videojuegos) { %>
                <div class="column">
                    <a href="/videojuegos/<%= juego.id %>"><%= juego.nombre %></a><br>
                    <span class="tag"><%= juego.tipo %></span>
                    <figure class="image">
                        <img class="is-rounded" src="<%= juego.imagen %>" />
                    </figure>
                    <% for (let privilegio of privilegios) { %>
                      <% if (privilegio.privilegio == 'crear_videojuegos') { %>
                        <br>
                        <a href="/videojuegos/<%= juego.id %>/edit" class="button is-primary">Editar</a>
                      <% } %>
                    <% } %>
                </div>
        <% } %>
           
              </div>
            </div>
          </section>
          <section class="section">
            <div class="container">
              <div class="columns">
                <div class="column">
                  <h1 class="title">Comandos de git</h1>
                  <ul>
                    <li>git add: Sirve para agregar cambios a la transacción.</li>
                    <li>
                      git commit -m "mensaje en imperativo": Sirve para comprometer 
                      la transacción, es decir, guardar los cambios.
                    </li>
                    <li>git checkout <strong>[nombre_rama]</strong>: Sirve para cambiarse de rama.</li>
                    <li>
                      git checkout -b [nombre_rama]: Sirve para crear una nueva rama y 
                      cambiarse a esa nueva rama.
                    </li>
                    <li>
                      git push: Sirve para sincronizar los cambios desde mi repositorio 
                      hacia el repositorio remoto.
                    </li>
                    <li>
                      git pull: Sirve para sincronizar los cambios del repositorio remoto 
                      hacia mi repositorio.
                    </li>
                  </ul>
                </div>
              </div>  
  
<script>
  const buscar = document.getElementById("buscar");
  buscar.onkeyup = () => {
  fetch(`/videojuegos/buscar/${buscar.value}`,{
      method: 'GET',
    }).then((result) => {
      return result.json(); 
    }).then((data) => {
      console.log(data); 
let html = '';

      for (let juego of data.videojuegos) { 
        html += `<div class="column">
                    <a href="/videojuegos/${juego.id}">${juego.nombre}</a><br>
                    <span class="tag">${juego.nombre}</span>
                    <figure class="image">
                        <img class="is-rounded" src="${juego.imagen}" />
                    </figure>`;
                    <% for (let privilegio of privilegios) { %>
                      <% if (privilegio.privilegio == 'crear_videojuegos') { %>
                        html += `<br>
                        <a href="/videojuegos/${juego.id}/edit" class="button is-primary">Editar</a>`;
                      <% } %>
                    <% } %>
                html += `</div>`;
      }

      const lista = document.getElementById("lista");
      lista.innerHTML = html;
    }).catch((error) => {
      console.log(error);
    });
  }
</script>